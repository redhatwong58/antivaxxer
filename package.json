{
  "name": "antivaxxer",
  "version": "0.1.0",
  "private": true,
  "description": "ANTIVAXXER — Streetwear with a Statement",
  "workspaces": [
    "frontend",
    "api",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:api": "npm run dev --workspace=api",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=api",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,css,md}\"",
    "db:ready": "node scripts/wait-for-postgres.js",
    "db:bootstrap": "npm run db:ready && npm run db:migrate:dev --workspace=api && npm run db:seed --workspace=api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
