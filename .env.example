# ============================================================
# ANTIVAXXER — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. Only .env.example is committed.
# ============================================================


# ============================================================
# REQUIRED NOW — The site will not run without these
# ============================================================

# PostgreSQL connection string (required by Prisma + api/loadEnv.js).
# Install Postgres locally (see README), create database `antivaxxer_dev`, then set a real URL.
#
# macOS Homebrew — usually your macOS username, no password (`whoami`):
DATABASE_URL=postgresql://YOUR_USERNAME@localhost:5432/antivaxxer_dev
#
# Windows installer — often user `postgres` and the password you chose:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/antivaxxer_dev
#
# Copy this file to `.env` at the repo root — api/ loads it automatically (see api/loadEnv.js).

# Any string you choose. This is the password for the /admin page.
# Not connected to any platform — you make this up.
# Example: my-secret-admin-token-2025
ADMIN_TOKEN=replace-with-any-secret-string

# These have working defaults — only change if you use non-standard ports.
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NODE_ENV=development

# Stripe (payments) — get test keys from https://dashboard.stripe.com/apikeys
# Required for checkout to work. Test keys are free.
STRIPE_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret


# ============================================================
# OPTIONAL — Email confirmation (works without, just skips sending)
# ============================================================

# AWS SES (order confirmation emails) — requires AWS account + verified domain
# If not configured, orders still process — email is just skipped.
# SES_FROM_EMAIL=orders@antivaxxer.com
# SES_REPLY_TO_EMAIL=support@antivaxxer.com


# ============================================================
# PHASE 3 — Needed when configured, graceful fallback if not
# ============================================================

# NextAuth.js (user login/registration)
# Required for user accounts to work.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-generated-secret

# Shippo (real shipping rates) — falls back to flat rate if not set
# Get key from https://apps.goshippo.com/
# SHIPPO_API_KEY=shippo_test_your_key

# Cloudflare Turnstile (bot protection) — skipped if not set, rate limiting is fallback
# Get keys from https://dash.cloudflare.com/
# TURNSTILE_SECRET_KEY=your_turnstile_secret
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Mailchimp (marketing emails) — subscribes work without, just logs warning
# Get API key from https://mailchimp.com/
# MAILCHIMP_API_KEY=your_api_key
# MAILCHIMP_SERVER_PREFIX=us1
# MAILCHIMP_LIST_ID=your_list_id

# Google Analytics 4 — only fires after CookiesYes consent
# Get measurement ID from https://analytics.google.com/
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Abandoned cart recovery delay (milliseconds)
# Default: 3600000 (1 hour). Set to 0 to disable.
# ABANDONED_CART_DELAY_MS=3600000

# Inventory alerts — email when stock drops below thresholds
# Apparel-standard defaults: warning at 15, reorder at 5 (per variant/SKU)
# INVENTORY_ALERT_EMAIL=ops@antivaxxer.com
# INVENTORY_WARNING_THRESHOLD=15
# INVENTORY_REORDER_THRESHOLD=5


# ============================================================
# IMAGE UPLOAD — Needed for product images
# ============================================================

# AWS credentials — requires AWS account with S3 and CloudFront set up
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET_NAME=antivaxxer-images-dev
# CLOUDFRONT_DOMAIN=your-distribution-id.cloudfront.net


# ============================================================
# OPTIONAL — Site identity and integrations
# ============================================================

# Public site URL for SEO (sitemap, canonical URLs, Open Graph)
# NEXT_PUBLIC_SITE_URL=https://antivaxxer.com

# CookiesYes consent banner — get ID from https://app.cookieyes.com/
# NEXT_PUBLIC_COOKIESYES_ID=your_cookiesyes_client_id
